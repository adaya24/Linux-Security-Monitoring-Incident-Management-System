import sys
from pathlib import Path

BACKEND_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(BACKEND_DIR))

from database.connection import get_connection


def evaluate_process(process):
    """Generate rule-based alerts from process resource usage."""
    alerts = []

    cpu = float(process.get("cpu_percent", 0))
    memory = float(process.get("memory_mb", 0))
    pid = int(process["pid"])
    name = process.get("name", "Unknown")

    if cpu > 95:
        alerts.append({
            "pid": pid,
            "event_type": "HIGH_CPU_USAGE",
            "severity": "HIGH",
            "description": (
                f"Process {name} (PID {pid}) is using "
                f"{cpu:.2f}% CPU. Investigate if sustained."
            )
        })
    elif cpu > 80:
        alerts.append({
            "pid": pid,
            "event_type": "ELEVATED_CPU_USAGE",
            "severity": "MEDIUM",
            "description": (
                f"Process {name} (PID {pid}) is using "
                f"{cpu:.2f}% CPU."
            )
        })

    # These are initial, configurable per-process memory thresholds.
    if memory > 1024:
        alerts.append({
            "pid": pid,
            "event_type": "HIGH_MEMORY_USAGE",
            "severity": "HIGH",
            "description": (
                f"Process {name} (PID {pid}) is using "
                f"{memory:.2f} MB of resident memory."
            )
        })
    elif memory > 512:
        alerts.append({
            "pid": pid,
            "event_type": "ELEVATED_MEMORY_USAGE",
            "severity": "MEDIUM",
            "description": (
                f"Process {name} (PID {pid}) is using "
                f"{memory:.2f} MB of resident memory."
            )
        })

    return alerts


def save_alerts(alerts):
    """Store generated alerts in MariaDB."""
    if not alerts:
        return 0

    connection = get_connection()
    cursor = None

    try:
        cursor = connection.cursor()
        query = """
            INSERT INTO security_events
            (pid, event_type, severity, description)
            VALUES (%s, %s, %s, %s)
        """

        values = [
            (
                alert["pid"],
                alert["event_type"],
                alert["severity"],
                alert["description"]
            )
            for alert in alerts
        ]

        cursor.executemany(query, values)
        connection.commit()
        return cursor.rowcount

    except Exception:
        connection.rollback()
        raise

    finally:
        if cursor is not None:
            cursor.close()
        connection.close()
